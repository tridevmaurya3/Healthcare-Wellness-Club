# Healthcare Wellness Club — STEP 25 production environment template
# Copy these variable names into your hosting/server environment. Never commit real secrets.

HWC_APP_ENV=production
HWC_APP_URL=https://your-domain.example
HWC_ALLOWED_HOSTS=your-domain.example,www.your-domain.example
HWC_TRUSTED_PROXIES=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=healthcare_wellness_club
DB_USER=hwc_app_user
DB_PASS=CHANGE_ON_SERVER_ONLY

# 24+ random characters. Sent as X-HWC-Health-Token header to /business/healthz.php
HWC_HEALTH_TOKEN=CHANGE_ON_SERVER_ONLY

# Used only by scheduled CLI backup job; never store in Git.
HWC_BACKUP_PASSPHRASE=CHANGE_ON_SERVER_ONLY

# Random server-only secret used to one-way hash public form IPs for rate limiting.
# Keep it stable after production activation so rate-limit hashes remain consistent.
HWC_PUBLIC_FORM_PEPPER=CHANGE_ON_SERVER_ONLY

# STEP 21 provider-neutral communication relays.
# Leave blank/undefined until a private relay is configured. Real URLs/tokens belong on the server only.
HWC_COMM_EMAIL_WEBHOOK_URL=
HWC_COMM_EMAIL_WEBHOOK_TOKEN=
HWC_COMM_WHATSAPP_WEBHOOK_URL=
HWC_COMM_WHATSAPP_WEBHOOK_TOKEN=
HWC_COMM_SMS_WEBHOOK_URL=
HWC_COMM_SMS_WEBHOOK_TOKEN=

# Private mounted cloud/NAS/offsite folder for verified backup copies.
HWC_OFFSITE_PATH=/private/offsite/hwc

# Optional: increase only after confirming PHP memory for larger databases.
HWC_BACKUP_MAX_PLAINTEXT_BYTES=67108864
